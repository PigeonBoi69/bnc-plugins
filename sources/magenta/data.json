{
  "id": "sample.magenta",
  "name": "Magenta (sample)",
  "version": "1.0.0",
  "author": "BNC",
  "type": "theme",
  "apiVersion": 1,
  "description": "Vivid magenta and plum. A sample style for BNC Ambient, BNC Docs, BNC Presentation, BNC Sheets and BNC PDF: it recolors the app and changes the app icon.",
  "colors": {
    "accent": "#d946ef",
    "accentInk": "#2e0a35",
    "swatch": [
      "#f0abfc",
      "#86198f"
    ]
  },
  "apps": {
    "bnc-ambient": {
      "icon": "bnc-ambient/icon.png"
    },
    "bnc-docs": {
      "icon": "bnc-docs/icon.png"
    },
    "bnc-presentation": {
      "icon": "bnc-presentation/icon.png"
    },
    "bnc-sheets": {
      "icon": "bnc-sheets/icon.png"
    },
    "bnc-pdf": {
      "icon": "bnc-pdf/icon.png"
    }
  }
}
