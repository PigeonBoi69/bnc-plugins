{
  "id": "sample.indigo",
  "name": "Indigo (sample)",
  "version": "1.0.0",
  "author": "BNC",
  "type": "theme",
  "apiVersion": 1,
  "description": "Indigo and midnight blue. A sample style for BNC Ambient, BNC Docs, BNC Presentation, BNC Sheets and BNC PDF: it recolors the app and changes the app icon.",
  "colors": {
    "accent": "#6366f1",
    "accentInk": "#ffffff",
    "swatch": [
      "#818cf8",
      "#312e81"
    ]
  },
  "apps": {
    "bnc-ambient": {
      "icon": "bnc-ambient/icon.png"
    },
    "bnc-docs": {
      "icon": "bnc-docs/icon.png"
    },
    "bnc-presentation": {
      "icon": "bnc-presentation/icon.png"
    },
    "bnc-sheets": {
      "icon": "bnc-sheets/icon.png"
    },
    "bnc-pdf": {
      "icon": "bnc-pdf/icon.png"
    }
  }
}
