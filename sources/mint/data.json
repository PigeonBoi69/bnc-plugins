{
  "id": "sample.mint",
  "name": "Mint (sample)",
  "version": "1.0.0",
  "author": "BNC",
  "type": "theme",
  "apiVersion": 1,
  "description": "Soft pastel mint. A sample style for BNC Ambient, BNC Docs, BNC Presentation, BNC Sheets and BNC PDF: it recolors the app and changes the app icon.",
  "colors": {
    "accent": "#8de8c0",
    "accentInk": "#052a1a",
    "swatch": [
      "#b9f5d8",
      "#2f8f68"
    ]
  },
  "apps": {
    "bnc-ambient": {
      "icon": "bnc-ambient/icon.png"
    },
    "bnc-docs": {
      "icon": "bnc-docs/icon.png"
    },
    "bnc-presentation": {
      "icon": "bnc-presentation/icon.png"
    },
    "bnc-sheets": {
      "icon": "bnc-sheets/icon.png"
    },
    "bnc-pdf": {
      "icon": "bnc-pdf/icon.png"
    }
  }
}
